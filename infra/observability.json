{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "APICompass six email alarms, operations dashboard and single-region management-event audit trail.",
  "Parameters": {
    "InstanceId": {
      "Type": "AWS::EC2::Instance::Id"
    },
    "AlertEmail": {
      "Type": "String",
      "NoEcho": true,
      "AllowedPattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+"
    }
  },
  "Resources": {
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "apicompass-alerts",
        "Subscription": [
          {
            "Protocol": "email",
            "Endpoint": {
              "Ref": "AlertEmail"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "APICompass"
          }
        ]
      }
    },
    "AlertsPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "Alerts"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Alerts"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:apicompass-*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "AuditBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "FiniteAuditRetention",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "APICompass"
          }
        ]
      }
    },
    "AuditBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuditBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuditBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AuditBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::GetAtt": [
                  "AuditBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/apicompass-assessment"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${AuditBucket.Arn}/AWSLogs/${AWS::AccountId}/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/apicompass-assessment"
                  },
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              }
            }
          ]
        }
      }
    },
    "AuditTrail": {
      "Type": "AWS::CloudTrail::Trail",
      "DependsOn": "AuditBucketPolicy",
      "Properties": {
        "TrailName": "apicompass-assessment",
        "S3BucketName": {
          "Ref": "AuditBucket"
        },
        "IsLogging": true,
        "IsMultiRegionTrail": false,
        "IncludeGlobalServiceEvents": true,
        "EnableLogFileValidation": true,
        "EventSelectors": [
          {
            "ReadWriteType": "All",
            "IncludeManagementEvents": true
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "APICompass"
          }
        ]
      }
    },
    "CpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlertsPolicy",
      "Properties": {
        "AlarmName": "apicompass-cpu",
        "AlarmDescription": "APICompass CPUUtilization: inspect the operations runbook; missing telemetry policy=notBreaching.",
        "Namespace": "AWS/EC2",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Period": 300,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 85,
        "ComparisonOperator": "GreaterThanThreshold",
        "Statistic": "Average",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "InstanceStatusAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlertsPolicy",
      "Properties": {
        "AlarmName": "apicompass-instancestatus",
        "AlarmDescription": "APICompass StatusCheckFailed: inspect the operations runbook; missing telemetry policy=notBreaching.",
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Period": 60,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "Statistic": "Maximum",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "DiskAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlertsPolicy",
      "Properties": {
        "AlarmName": "apicompass-disk",
        "AlarmDescription": "APICompass DiskUsedPercent: inspect the operations runbook; missing telemetry policy=breaching.",
        "Namespace": "APICompass",
        "MetricName": "DiskUsedPercent",
        "Dimensions": [
          {
            "Name": "Project",
            "Value": "APICompass"
          }
        ],
        "Period": 300,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 85,
        "ComparisonOperator": "GreaterThanThreshold",
        "Statistic": "Maximum",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "HealthAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlertsPolicy",
      "Properties": {
        "AlarmName": "apicompass-health",
        "AlarmDescription": "APICompass HealthFailure: inspect the operations runbook; missing telemetry policy=breaching.",
        "Namespace": "APICompass",
        "MetricName": "HealthFailure",
        "Dimensions": [
          {
            "Name": "Project",
            "Value": "APICompass"
          }
        ],
        "Period": 300,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "Statistic": "Maximum",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "BackupFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlertsPolicy",
      "Properties": {
        "AlarmName": "apicompass-backupfailure",
        "AlarmDescription": "APICompass BackupFailure: inspect the operations runbook; missing telemetry policy=breaching.",
        "Namespace": "APICompass",
        "MetricName": "BackupFailure",
        "Dimensions": [
          {
            "Name": "Project",
            "Value": "APICompass"
          }
        ],
        "Period": 21600,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "Statistic": "Maximum",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AnswerFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlertsPolicy",
      "Properties": {
        "AlarmName": "apicompass-answerfailure",
        "AlarmDescription": "APICompass AnswerFailure: inspect the operations runbook; missing telemetry policy=breaching.",
        "Namespace": "APICompass",
        "MetricName": "AnswerFailure",
        "Dimensions": [
          {
            "Name": "Project",
            "Value": "APICompass"
          }
        ],
        "Period": 300,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "Statistic": "Sum",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "Dashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": "APICompass-Operations",
        "DashboardBody": {
          "Fn::Sub": "{\"widgets\":[{\"type\":\"metric\",\"x\":0,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"CPUUtilization\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Average\",\"metrics\":[[\"AWS/EC2\",\"CPUUtilization\",\"InstanceId\",\"${InstanceId}\"]]}},{\"type\":\"metric\",\"x\":12,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"StatusCheckFailed\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":60,\"stat\":\"Maximum\",\"metrics\":[[\"AWS/EC2\",\"StatusCheckFailed\",\"InstanceId\",\"${InstanceId}\"]]}},{\"type\":\"metric\",\"x\":0,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"DiskUsedPercent\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Maximum\",\"metrics\":[[\"APICompass\",\"DiskUsedPercent\",\"Project\",\"APICompass\"]]}},{\"type\":\"metric\",\"x\":12,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"HealthFailure\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Maximum\",\"metrics\":[[\"APICompass\",\"HealthFailure\",\"Project\",\"APICompass\"]]}},{\"type\":\"metric\",\"x\":0,\"y\":12,\"width\":12,\"height\":6,\"properties\":{\"title\":\"BackupFailure\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":21600,\"stat\":\"Maximum\",\"metrics\":[[\"APICompass\",\"BackupFailure\",\"Project\",\"APICompass\"]]}},{\"type\":\"metric\",\"x\":12,\"y\":12,\"width\":12,\"height\":6,\"properties\":{\"title\":\"AnswerFailure\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Sum\",\"metrics\":[[\"APICompass\",\"AnswerFailure\",\"Project\",\"APICompass\"]]}},{\"type\":\"metric\",\"x\":0,\"y\":18,\"width\":24,\"height\":6,\"properties\":{\"title\":\"Backup age (health fails above 8 hours)\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Maximum\",\"metrics\":[[\"APICompass\",\"BackupAgeHours\",\"Project\",\"APICompass\"]]}},{\"type\":\"metric\",\"x\":0,\"y\":24,\"width\":24,\"height\":6,\"properties\":{\"title\":\"Synthetic API check duration (not full chat latency)\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Average\",\"metrics\":[[\"APICompass\",\"HealthLatencyMs\",\"Project\",\"APICompass\"]]}},{\"type\":\"metric\",\"x\":0,\"y\":30,\"width\":12,\"height\":6,\"properties\":{\"title\":\"Questions attempted (request volume)\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Sum\",\"metrics\":[[\"APICompass\",\"AnswerSuccess\",\"Project\",\"APICompass\",{\"id\":\"success\",\"visible\":false}],[\"APICompass\",\"AnswerFailure\",\"Project\",\"APICompass\",{\"id\":\"failure\",\"visible\":false}],[{\"expression\":\"success+failure\",\"id\":\"attempts\",\"label\":\"Question attempts\"}]]}},{\"type\":\"metric\",\"x\":12,\"y\":30,\"width\":12,\"height\":6,\"properties\":{\"title\":\"Observed question attempt duration\",\"region\":\"${AWS::Region}\",\"view\":\"timeSeries\",\"period\":300,\"stat\":\"Average\",\"metrics\":[[\"APICompass\",\"AnswerLatencyMs\",\"Project\",\"APICompass\"]]}}]}"
        }
      }
    }
  },
  "Outputs": {
    "AlertsTopic": {
      "Value": {
        "Ref": "Alerts"
      }
    },
    "AuditBucketName": {
      "Value": {
        "Ref": "AuditBucket"
      }
    }
  }
}
