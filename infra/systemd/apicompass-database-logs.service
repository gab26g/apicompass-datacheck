[Unit]
Description=APICompass sanitized MongoDB envelope shipment
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/apicompass/ops.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apicompass
EnvironmentFile=/etc/apicompass/ops.env
ExecStart=/opt/apicompass-tools/bin/python scripts/ship_database.py
StateDirectory=apicompass-database-logs
StateDirectoryMode=0700
TimeoutStartSec=120
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
